rules_version = '2';

// All data access goes through the Next.js route handlers using the Admin SDK,
// which bypasses these rules. Direct client reads/writes are denied so that
// scenario snapshots stay immutable and roles cannot be self-assigned.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

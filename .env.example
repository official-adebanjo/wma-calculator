# --- Firebase client (Auth only) -------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin (server only; never commit real values) -----------------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the private key with literal \n sequences; they are converted at runtime.
FIREBASE_PRIVATE_KEY=

# --- Roles (comma-separated emails). Everyone else is a QA Tester. ----------
ADMIN_EMAILS=
REVIEWER_EMAILS=

# --- Local emulators: uncomment to run fully offline -----------------------
# NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true
# NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-rfs-calculator
# NEXT_PUBLIC_FIREBASE_API_KEY=demo-key
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=localhost
# NEXT_PUBLIC_FIREBASE_APP_ID=demo-app
# FIREBASE_PROJECT_ID=demo-rfs-calculator
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
